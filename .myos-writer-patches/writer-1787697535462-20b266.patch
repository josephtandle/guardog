+  assert.deepEqual(request.packages, [
+    { name: "@scope/pkg", ecosystem: "npm", version: "1.2.3" },
+    { name: "lodash", ecosystem: "npm", version: "4.17.21" },
+  ]);
+});
+
+test("legacy Guardog install syntax remains npm-compatible", async () => {
