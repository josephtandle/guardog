+
+test("quick setup is local-only and VirusTotal keys are stored privately", async () => {
+  const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "guardog-setup-"));
+  const previousHome = process.env.GUARDOG_HOME;
